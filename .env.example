# RPC Robinhood Chain (Alchemy / publik). Menimpa preset di config.
RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Alamat kontrak NFT (bisa juga diisi di config.json / flag --contract)
CONTRACT=

# Satu private key
PRIVATE_KEY=

# Atau banyak sekaligus, dipisah koma (alternatif dari keys.txt)
PRIVATE_KEYS=

# Opsional: untuk command `resolve` (cari contract dari slug OpenSea)
OPENSEA_API_KEY=
